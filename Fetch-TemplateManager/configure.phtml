<form action="<?= _url('extension', 'configure', 'e', $this->getName()) ?>" method="post">
    <input type="hidden" name="_csrf" value="<?= Minz_Session::param('csrf') ?>" />
    <button type="button" class="btn" onclick="createTemplate()" style="margin-bottom: 20px;">+ Create Master Template</button>
    <div id="template-list" style="display: grid; gap: 15px; margin-bottom: 20px;"></div>
    <input type="hidden" id="templates_data" name="templates" value="<?= htmlspecialchars($this->getSystemConfiguration('fetch_templates', '[]')) ?>">
    <button type="submit" class="btn btn-important">Save Configurations</button>
</form>

<script>
    let templates = JSON.parse(document.getElementById('templates_data').value || '[]');

    function renderTemplates() {
        const container = document.getElementById('template-list');
        container.innerHTML = '';
        templates.forEach(t => {
            const div = document.createElement('div');
            div.style = 'border: 1px solid #ddd; padding: 15px; border-radius: 6px; background: #fff;';
            div.innerHTML = `
                <div style="margin-bottom: 15px;">
                    <h3 style="margin: 0 0 5px 0;">${t.name}</h3>
                    <span style="background: #eee; padding: 2px 6px; border-radius: 3px; font-size: 12px;">Parser: ${t.type}</span><br>
                    <small style="display: block; margin-top: 8px;"><strong>Trigger:</strong> <code>${t.match_url || 'N/A'}</code></small>
                    <small style="display: block;"><strong>Auto-Tag:</strong> ${t.custom_tag || 'None'}</small>
                    <small style="display: block;"><strong>Feed Desc Override:</strong> ${t.manual_feed_desc ? 'Active' : 'None'}</small>
                    <small style="display: block;"><strong>Episode Desc Override:</strong> ${t.manual_ep_desc ? 'Active' : 'None'}</small>
                </div>
                <button type="button" class="btn btn-attention" onclick="deleteTemplate('${t.id}')">Delete</button>
            `;
            container.appendChild(div);
        });
        document.getElementById('templates_data').value = JSON.stringify(templates);
    }

    function createTemplate() {
        const name = prompt("Enter template name:");
        if (!name) return;
        const type = prompt("Enter XML Parser Type (youtube, anchor, redcircle):").toLowerCase();
        const matchUrl = prompt("Enter URL match string (e.g., 'redcircle.com'):");
        const customTag = prompt("Enter auto-tag (e.g., 'Platform: RedCircle'):");
        const manualFeedDesc = prompt("Override full Podcast Channel Description? (Leave blank to use original):");
        const manualEpDesc = prompt("Override/Prepend Episode Descriptions? (Leave blank to use original show notes):");
        const defaultImg = prompt("Enter fallback image URL (Leave blank for none):");
        
        templates.push({
            id: 'tpl_' + Date.now(), 
            name: name, 
            type: type, 
            match_url: matchUrl || '', 
            custom_tag: customTag || '',
            manual_feed_desc: manualFeedDesc || '',
            manual_ep_desc: manualEpDesc || '',
            default_image_url: defaultImg || '',
            custom_image_xpath: '',
            assigned_feeds: []
        });
        renderTemplates();
    }

    function deleteTemplate(id) {
        templates = templates.filter(t => t.id !== id);
        renderTemplates();
    }

    renderTemplates();
</script>
